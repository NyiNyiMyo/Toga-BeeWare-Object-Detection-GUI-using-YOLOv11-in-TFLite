pyproject.toml:
[build-system]
requires = ["briefcase"]

[tool.briefcase]
project_name = "YOLOv11 Detector"
bundle = "com.nyinyimyo"
version = "1.0.0"
url = "https://example.com/yolov11detector"
license.file = "LICENSE"
author = "NyiNyiMyo"
author_email = "nyinyi.m@kkumail.com"

[tool.briefcase.app.yolov11detector]
# Window title is set in code: "YOLOv11 Detector - Toga (BeeWare)".
# formal_name stays simple so installers / APK names don't choke on "()".
formal_name = "YOLOv11 Detector"
description = "YOLOv11 TFLite object detection on images, videos and webcams (Toga / BeeWare)"
sources = ["src/yolov11detector"]
test_sources = []

# shared by every platform
requires = [
    "numpy",
    "opencv-python-headless",
]

[tool.briefcase.app.yolov11detector.macOS]
universal_build = true
requires = ["toga-cocoa~=0.5.0", "ai-edge-litert"]

[tool.briefcase.app.yolov11detector.linux]
requires = ["toga-gtk~=0.5.0", "ai-edge-litert"]

[tool.briefcase.app.yolov11detector.linux.system.debian]
system_requires = [
    "libcairo2-dev", "libgirepository1.0-dev", "libgirepository-2.0-dev", "pkg-config", "python3-dev",
]
system_runtime_requires = ["libgtk-3-0", "gir1.2-gtk-3.0", "libglib2.0-0"]

[tool.briefcase.app.yolov11detector.windows]
requires = ["toga-winforms~=0.5.0", "ai-edge-litert"]

[tool.briefcase.app.yolov11detector.android]
requires = ["toga-android~=0.5.0", "tflite-runtime"]
base_theme = "Theme.MaterialComponents.Light.DarkActionBar"
build_gradle_dependencies = [
    "com.google.android.material:material:1.12.0",
]

[tool.briefcase.app.yolov11detector.android.permission]
camera = true

